#!/usr/bin/env python3
"""herdr-watchr - live herdr agent status in waybar.

Subcommands:
  status <name>        emit one status module's JSON and exit
  focus-status <name>  focus an agent in <name> and raise the terminal window
  notify               poll herdr and signal waybar when the rendered state changes
"""
import json
import os
import shutil
import subprocess
import sys
import time

VOCABULARY = ("blocked", "idle", "done", "working", "unknown")

HOST = "waybar"
HOST_SECTIONS = ("waybar", "macos")

DEFAULTS = {
    "urgency": list(VOCABULARY),
    "colors": {
        "blocked": "#d64545",
        "idle": "#4caf7d",
        "done": "#3aa6a6",
        "working": "#8b6fd4",
        "unknown": "#7a7f8c",
    },
    "poll_seconds": 1.5,
    "herdr_bin": None,
    "waybar": {
        "icons": {
            "blocked": "\U000F009A",
            "idle": "\U000F0134",
            "done": "\U000F05E0",
            "working": "\U000F06A9",
            "unknown": "\U000F02D7",
        },
        "signal": 8,
        "click_action": "first",
        "terminal": {"class": "com.mitchellh.ghostty", "title": "herdr"},
        "focus_window_cmd": ["hyprctl", "dispatch", "focuswindow",
                             "address:{addr}"],
    },
    "macos": {
        "icons": {
            "blocked": "bell.fill",
            "idle": "checkmark",
            "done": "checkmark.circle.fill",
            "working": "gearshape.fill",
            "unknown": "questionmark.circle",
        },
        "terminal": {"bundle_id": "com.mitchellh.ghostty"},
        "show_when_empty": True,
    },
}

_WARNED = set()


def warn(message):
    if message in _WARNED:
        return
    _WARNED.add(message)
    sys.stderr.write("herdr-watchr: %s\n" % message)


def normalize_urgency(value):
    if not isinstance(value, list):
        return list(VOCABULARY)
    if not all(isinstance(item, str) for item in value):
        return list(VOCABULARY)
    if sorted(value) != sorted(VOCABULARY):
        return list(VOCABULARY)
    return list(value)


def status_of(agent, urgency):
    value = agent.get("agent_status") or "unknown"
    return value if value in urgency else "unknown"


def stable_sort(agents):
    return sorted(agents, key=lambda a: a.get("pane_id") or "")


def group_agents(agents, urgency):
    groups = dict((name, []) for name in urgency)
    for agent in agents:
        groups[status_of(agent, urgency)].append(agent)
    return dict((name, stable_sort(groups[name])) for name in urgency)


def status_order(groups, urgency):
    return [name for name in urgency if groups.get(name)]


def select_target(matching, click_action):
    if not matching:
        return None
    if click_action != "cycle":
        return matching[0]
    for index, agent in enumerate(matching):
        if agent.get("focused") is True:
            return matching[(index + 1) % len(matching)]
    return matching[0]


def _copy(value):
    if isinstance(value, dict):
        return dict((key, _copy(item)) for key, item in value.items())
    if isinstance(value, list):
        return list(value)
    return value


def deep_merge(base, override):
    merged = dict((key, _copy(value)) for key, value in base.items())
    if not isinstance(override, dict):
        return merged
    for key, value in override.items():
        if isinstance(value, dict) and isinstance(merged.get(key), dict):
            merged[key] = deep_merge(merged[key], value)
        else:
            merged[key] = _copy(value)
    return merged


def config_path(env):
    override = env.get("HERDR_WATCHR_CONFIG")
    if override:
        return override
    base = env.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "herdr-watchr", "config.json")


def read_config_file(path):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            data = json.load(fh)
    except FileNotFoundError:
        return {}
    except Exception as exc:
        warn("cannot read config %s: %s" % (path, exc))
        return {}
    if not isinstance(data, dict):
        warn("config %s: top level must be an object" % path)
        return {}
    return data


def apply_env(resolved, env):
    binary = env.get("HERDR_WATCHR_BIN") or env.get("HERDR_BIN")
    if binary:
        resolved["herdr_bin"] = binary
    poll = env.get("HERDR_WATCHR_POLL")
    if poll:
        try:
            resolved["poll_seconds"] = float(poll)
        except ValueError:
            warn("HERDR_WATCHR_POLL is not a number: %s" % poll)
    signal = env.get("HERDR_WATCHR_SIGNAL")
    if signal:
        try:
            resolved["signal"] = int(signal)
        except ValueError:
            warn("HERDR_WATCHR_SIGNAL is not an integer: %s" % signal)
    return resolved


def load_config(env=None, host=HOST):
    env = os.environ if env is None else env
    file_data = read_config_file(config_path(env))
    sane_sections = dict((key, value) for key, value in file_data.items()
                         if key not in HOST_SECTIONS or isinstance(value, dict))
    merged = deep_merge(DEFAULTS, sane_sections)
    trunk = dict((k, v) for k, v in merged.items() if k not in HOST_SECTIONS)
    resolved = deep_merge(trunk, merged.get(host) or {})
    resolved["urgency"] = normalize_urgency(resolved.get("urgency"))
    return apply_env(resolved, env)


def herdr_bin(cfg):
    return (cfg.get("herdr_bin")
            or shutil.which("herdr")
            or os.path.expanduser("~/.local/bin/herdr"))


def poll_interval(cfg):
    try:
        value = float(cfg.get("poll_seconds", 1.5))
    except (TypeError, ValueError):
        return 1.5
    return max(value, 0.1)


def pango_escape(text):
    return (text.replace("&", "&amp;")
                .replace("<", "&lt;")
                .replace(">", "&gt;"))


def agent_line(agent):
    workspace = agent.get("workspace_id") or "?"
    title = (agent.get("terminal_title_stripped") or "").strip()
    return "%s  %s" % (pango_escape(workspace), pango_escape(title))


def status_output(name, agents, cfg):
    matching = group_agents(agents, cfg["urgency"]).get(name) or []
    if not matching:
        return {"text": "", "tooltip": "",
                "class": ["herdr-watchr", name, "empty"]}
    text = "<span color='%s'>%s</span> %d" % (
        cfg["colors"][name], cfg["icons"][name], len(matching))
    return {"text": text,
            "tooltip": "\n".join(agent_line(a) for a in matching),
            "class": ["herdr-watchr", name]}


def state_signature(agents, urgency):
    return tuple(sorted((a.get("pane_id") or "", status_of(a, urgency))
                        for a in agents))


def emit(payload):
    sys.stdout.write(json.dumps(payload) + "\n")
    sys.stdout.flush()


def fetch_agents(cfg):
    try:
        proc = subprocess.run([herdr_bin(cfg), "agent", "list"],
                              capture_output=True, text=True, timeout=3)
        agents = json.loads(proc.stdout).get("result", {}).get("agents")
    except Exception:
        return []
    return agents if isinstance(agents, list) else []


def pick_herdr_window(clients, terminal):
    title = terminal.get("title")
    window_class = terminal.get("class")
    if title:
        for client in clients:
            if client.get("title") == title:
                return client
    if window_class:
        for client in clients:
            if client.get("class") == window_class:
                return client
    return None


def render_focus_cmd(template, addr):
    if not template:
        return []
    return [str(part).replace("{addr}", addr) for part in template]


def raise_terminal_window(cfg):
    template = cfg.get("focus_window_cmd")
    if not template:
        return
    try:
        proc = subprocess.run(["hyprctl", "-j", "clients"],
                              capture_output=True, text=True, timeout=3)
        window = pick_herdr_window(json.loads(proc.stdout),
                                   cfg.get("terminal") or {})
        if not window or not window.get("address"):
            return
        subprocess.run(render_focus_cmd(template, window["address"]),
                       capture_output=True, text=True, timeout=3)
    except Exception as exc:
        warn("cannot raise the terminal window: %s" % exc)


def focus_agent(cfg, terminal_id):
    if not terminal_id:
        return
    try:
        subprocess.run([herdr_bin(cfg), "agent", "focus", terminal_id],
                       capture_output=True, text=True, timeout=3)
    except Exception as exc:
        warn("cannot focus the agent: %s" % exc)
    raise_terminal_window(cfg)


def nudge(signal):
    try:
        argv = ["pkill", "-RTMIN+%d" % int(signal), "waybar"]
    except (TypeError, ValueError):
        warn("signal is not an integer: %s" % signal)
        return
    try:
        subprocess.run(argv, capture_output=True)
    except Exception as exc:
        warn("cannot signal waybar: %s" % exc)


USAGE = "usage: herdr-watchr {status <name>|focus-status <name>|notify}\n"


def cmd_status(name):
    try:
        cfg = load_config()
        payload = status_output(name, fetch_agents(cfg), cfg)
    except Exception as exc:
        warn("cannot render status %s: %s" % (name, exc))
        payload = {"text": "", "tooltip": "",
                   "class": ["herdr-watchr", name, "empty"]}
    emit(payload)


def cmd_focus_status(name):
    try:
        cfg = load_config()
        matching = group_agents(fetch_agents(cfg), cfg["urgency"]).get(name) or []
        target = select_target(matching, cfg.get("click_action"))
    except Exception as exc:
        warn("cannot focus status %s: %s" % (name, exc))
        return
    if target:
        focus_agent(cfg, target.get("terminal_id"))


def cmd_notify():
    emit({"text": "", "tooltip": "", "class": ["herdr-watchr", "notify"]})
    cfg = load_config()
    last = None
    while True:
        try:
            cfg = load_config()
            signature = state_signature(fetch_agents(cfg), cfg["urgency"])
            if signature != last:
                last = signature
                nudge(cfg.get("signal", 8))
        except Exception as exc:
            warn("notify: %s" % exc)
        time.sleep(poll_interval(cfg))


def main(argv):
    command = argv[1] if len(argv) > 1 else "notify"
    if command == "status" and len(argv) > 2:
        cmd_status(argv[2])
        return 0
    if command == "focus-status" and len(argv) > 2:
        cmd_focus_status(argv[2])
        return 0
    if command == "notify":
        cmd_notify()
        return 0
    sys.stderr.write(USAGE)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
